# =============================================================
# Console LLM — chaves de API
# Copie este arquivo para ".env" e cole suas chaves reais.
# Você só precisa preencher as chaves dos provedores que quiser usar.
# Nenhuma chave aqui sai do seu computador — o servidor local é o
# único lugar que lê esse arquivo, e o navegador nunca vê o conteúdo.
# =============================================================

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (Llama, Kimi, GPT-OSS — inferência ultra-rápida) — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras (free tier de 1M tokens/dia, sem cartão) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Mistral AI (free tier "Experiment", ~1B tokens/mês, exige verificação de telefone) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# NVIDIA NIM (catálogo com modelos gratuitos) — https://build.nvidia.com
NVIDIA_API_KEY=

# OpenRouter (agregador de dezenas de provedores) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Porta do servidor local (opcional)
PORT=3344
