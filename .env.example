# =============================================================
# Claudio — variáveis de ambiente
#
# Copie para ".env" (raiz) para rodar a bancada de humor, e para
# "worker/.dev.vars" para rodar o Worker local com `npm run dev`.
#
# Em produção NADA daqui vive em arquivo: a chave entra como secret
# do Cloudflare (`npm run secret`) e o resto como [vars] no
# worker/wrangler.toml. A chave NUNCA chega ao navegador — quem fala
# com a Groq é o Worker; o front só fala com o Worker.
# =============================================================

# ---- Provider (obrigatório) ---------------------------------
# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Corrente de modelos, em ordem de preferência, separados por vírgula.
# O teto do free tier da Groq é POR MODELO: quando o primeiro esgota a cota
# do dia, o seguinte ainda está inteiro. Cada modelo a mais é um dia extra
# de funcionamento. Trocar a corrente é trocar esta linha, não mexer em código.
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Orçamento ----------------------------------------------
# Teto real do free tier da Groq: 30 req/min · 1.000 req/dia · 12k tokens/min.
# Os valores abaixo ficam ABAIXO do teto de propósito: estourar devolve 429
# para a conta inteira, não só para quem estourou. Isto é restrição de
# projeto, não detalhe de configuração — leia o README antes de aumentar.
CLAUDIO_MAX_TOKENS=220            # teto de saída por resposta (piada curta)
# O gargalo real não é requisição/dia (1.000) e sim TOKEN/dia (~100k por
# modelo). Com ~1.400 tokens de prompt por chamada, cada modelo aguenta ~70
# mensagens/dia; com os 5 da corrente, ~350.
CLAUDIO_DAILY_BUDGET=320          # chamadas/dia no total
CLAUDIO_RPM_BUDGET=24             # chamadas/min no total
CLAUDIO_TPM_BUDGET=10000          # tokens/min no total
CLAUDIO_IP_PER_MIN=4              # mensagens/min por IP
CLAUDIO_IP_PER_DAY=40             # mensagens/dia por IP
CLAUDIO_SESSION_PER_DAY=60        # mensagens/dia por aba do navegador
CLAUDIO_HISTORY_TURNS=6           # mensagens do histórico reenviadas

# ---- Operação -----------------------------------------------
# Kill switch. Qualquer valor diferente de "off" derruba o produto sem
# redeploy — o Claudio passa a responder que tirou folga.
CLAUDIO_KILL_SWITCH=off

# Origens autorizadas a chamar o Worker, separadas por vírgula.
ALLOWED_ORIGINS=https://rceschim-cpu.github.io,http://localhost:8787,http://127.0.0.1:8787

# ---- Bancada de humor (bench/, só na sua máquina) ------------
BENCH_RPM=15
BENCH_TPM=10000
